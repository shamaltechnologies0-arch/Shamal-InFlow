# MongoDB Atlas connection string (REQUIRED)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shamal-inflow?retryWrites=true&w=majority
DATABASE_URL=

# Payload CMS secret (random string, min 32 chars)
PAYLOAD_SECRET=

# Public URL of the Next.js app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seeded admin login (created automatically on first successful DB connect)
SEED_ADMIN_EMAIL=admin@shamal.sa
SEED_ADMIN_PASSWORD=ShamalInFlow!2026

# AWS S3 (optional for local UI; required for media / flight log uploads)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
